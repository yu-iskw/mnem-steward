PORT=8080
PUBLIC_BASE_URL=http://127.0.0.1:8080
AUTH_MODE=local
MEMORY_STORE=in-memory
LOCAL_JWT_SECRET=local-dev-secret-at-least-32-bytes!
# Required for STDIO MCP (`pnpm --filter @mnem-steward/gateway mcp:stdio`)
# MNEM_ACCESS_TOKEN=
# MNEM_STEWARD_MCP_PROFILES=memory-reader,memory-steward,memory-governance
# AUTH_MODE=jwks
# AUTH_ISSUER=https://issuer.example
# AUTH_AUDIENCE=https://memory.company.example
# AUTH_JWKS_URL=https://issuer.example/.well-known/jwks.json
# MEMORY_STORE=google
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=eu
# GOOGLE_REASONING_ENGINE_ID=
# Google Memory Bank credential (separate from MNEM_ACCESS_TOKEN / MCP JWT)
# GOOGLE_CREDENTIAL_MODE=adc
# GOOGLE_ACCESS_TOKEN=
# GOOGLE_IMPERSONATE_SERVICE_ACCOUNT=memory-bank@PROJECT.iam.gserviceaccount.com
